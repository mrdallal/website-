# --- Core ------------------------------------------------------------------
# PostgreSQL connection string. Local dev: `pnpm db:dev` prints one.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/techsides?sslmode=disable"

# Public site URL (used for canonical URLs, sitemap, OG metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth (Auth.js) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Initial admin user created by `pnpm db:seed`
ADMIN_NAME="TECHSIDES Admin"
ADMIN_EMAIL="admin@techsides.local"
ADMIN_PASSWORD="change-me-before-deploying"

# --- Email (Resend) - optional ----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="TECHSIDES <hello@yourdomain.com>"
# Where internal "new lead" notifications go
NOTIFY_EMAIL=""

# --- GoHighLevel - optional --------------------------------------------------
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_WEBHOOK_URL=""
# Shared secret that inbound GHL webhooks must send in the x-ghl-signature header
GHL_WEBHOOK_SECRET=""

# --- Analytics - optional ----------------------------------------------------
# one of: none | ga4 | plausible | posthog
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
