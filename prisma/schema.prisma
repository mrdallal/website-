// TECHSIDES data model
// PostgreSQL + Prisma. Generated client lives in src/generated/prisma (git-ignored).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TEAM_MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum ActivityType {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_UPDATED
  NOTE
  PROJECT_CREATED
  PROJECT_UPDATED
  TASK_CREATED
  TASK_UPDATED
  CLIENT_CREATED
  INTEGRATION
  SYSTEM
}

// ---------------------------------------------------------------------------
// Team
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TEAM_MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks Task[]     @relation("TaskAssignee")
  ownedProjects Project[]  @relation("ProjectOwner")
  activities    Activity[]
}

// ---------------------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------------------

model Lead {
  id       String     @id @default(cuid())
  name     String
  email    String
  company  String?
  website  String?
  service  String?
  budget   String?
  timeline String?
  message  String?
  status   LeadStatus @default(NEW)
  source   String     @default("website")
  notes    String?

  // Integration bookkeeping (never exposed publicly)
  ghlContactId String?
  ghlSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  client     Client?

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([source])
  @@index([service])
}

model Client {
  id      String       @id @default(cuid())
  name    String
  company String?
  email   String?
  website String?
  status  ClientStatus @default(ACTIVE)
  notes   String?

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  category    String?
  status      ProjectStatus @default(DRAFT)
  featured    Boolean       @default(false)
  image       String?
  notes       String?
  deadline    DateTime?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasks      Task[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([ownerId])
  @@index([featured])
  @@index([deadline])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  position    Int          @default(0)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  metadata    Json?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([projectId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Configuration & first-party analytics
// ---------------------------------------------------------------------------

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  source    String?
  path      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}
